# Google Cloud Run Environment Variables for InnoVet Backend
# Copy this file to .env and update with your actual values

# =============================================================================
# REQUIRED VARIABLES (Backend won't work without these)
# =============================================================================

# Server Configuration
NODE_ENV=production
PORT=8080

# Firebase Admin SDK (CRITICAL - Backend won't start without these)
FIREBASE_PROJECT_ID=your-actual-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour actual private key here\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=your-actual-client-email@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# =============================================================================
# EMAIL CONFIGURATION (Required for OTP and verification emails)
# =============================================================================

# Email Service Configuration
# Choose one of: 'gmail', 'sendgrid', 'smtp'
EMAIL_SERVICE=gmail

# Gmail Configuration (if using Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-gmail-app-password
EMAIL_FROM=noreply@innovet.com

# SendGrid Configuration (if using SendGrid - recommended for production)
SENDGRID_API_KEY=your-sendgrid-api-key

# Custom SMTP Configuration (if using custom SMTP)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password



# =============================================================================
# SMS CONFIGURATION (Optional - for SMS notifications)
# =============================================================================

# Semaphore SMS Service (Philippines)
SEMAPHORE_API_KEY=your-actual-semaphore-api-key
SEMAPHORE_SENDER_NAME=InnoVet

# Alternative SMS services (if not using Semaphore)
SMS_API_KEY=your-actual-sms-api-key
SMS_API_SECRET=your-actual-sms-api-secret

# =============================================================================
# CORS & SECURITY
# =============================================================================

# Allowed origins for CORS
ALLOWED_ORIGINS=https://innovet-projects.vercel.app,http://localhost:3000

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# =============================================================================
# CLOUD RUN SPECIFIC (Auto-filled after deployment)
# =============================================================================

# Your Cloud Run service URL (will be provided after deployment)
CLOUD_RUN_SERVICE_URL=https://your-service-url-here

# =============================================================================
# NOTES:
# =============================================================================
# 1. Firebase credentials are MANDATORY - get them from Firebase Console
# 2. Email services (OTP, verification) are now handled by the Node.js backend
# 3. SMS is optional but recommended for notifications
# 4. Copy this file to .env and fill in your actual values
# 5. Never commit .env to version control
# 6. Email configuration is REQUIRED for OTP functionality
# 7. For Gmail, use App Password (not regular password) - enable 2FA first
# 8. For production, consider using SendGrid or AWS SES for better deliverability
