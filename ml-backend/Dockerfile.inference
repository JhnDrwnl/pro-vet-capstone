# Use Python 3.10 slim image for inference
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements-inference.txt .
RUN pip install --no-cache-dir -r requirements-inference.txt

# Copy the inference app
COPY inference_app/ ./inference_app/
COPY species_models/ ./species_models/
COPY inference_settings.py .
COPY inference_urls.py .
COPY inference_wsgi.py .
COPY manage.py .

# Create database and collect static files
RUN python manage.py collectstatic --noinput --settings=inference_settings

# Create a startup script to run migrations
RUN echo '#!/bin/bash\npython manage.py migrate --settings=inference_settings\npython manage.py collectstatic --noinput --settings=inference_settings\nexec "$@"' > /app/start.sh
RUN chmod +x /app/start.sh

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/predictions/health/ || exit 1

# Start the application
CMD ["/app/start.sh", "gunicorn", "--bind", "0.0.0.0:8000", "--workers", "1", "--timeout", "120", "--max-requests", "1000", "--max-requests-jitter", "100", "inference_wsgi:application"]

